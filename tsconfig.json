{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@engine": ["src/engine/index.ts"], "@engine/*": ["src/engine/*"], "@game/*": ["src/game/*"] }
  },
  "include": ["src", "tests"],
  "exclude": ["tests/e2e"]
}
